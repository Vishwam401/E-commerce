# ╔══════════════════════════════════════════════════════════════╗
# ║   Alpha-Commerce — Production Environment File              ║
# ║   Location on server: /opt/alpha-commerce/env/production.env║
# ║   Permission: chmod 600   (root-readable only)              ║
# ║   NEVER commit this file to Git                             ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Core ──────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://alphauser:CHANGE_THIS_DB_PASSWORD@postgres:5432/ecommerce_db
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_64_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=production
DEBUG=false

# ── CORS (exact Vercel frontend URL — no trailing slash) ──────
CORS_ORIGINS=https://app.alpha-commerce.tech

# ── Email links (frontend Vercel origin) ──────────────────────
EMAIL_VERIFY_BASE_URL=https://app.alpha-commerce.tech

# ── PostgreSQL (must match postgres service above) ────────────
POSTGRES_USER=alphauser
POSTGRES_PASSWORD=CHANGE_THIS_DB_PASSWORD
POSTGRES_DB=ecommerce_db

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# ── SMTP (use App Password / API SMTP — not your login password)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_smtp_app_password
MAIL_FROM=your_email@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# ── Razorpay (Test Mode only for portfolio) ───────────────────
RAZORPAY_KEY_ID=rzp_test_CHANGE_THIS
RAZORPAY_SECRET_KEY=CHANGE_THIS_RAZORPAY_SECRET
RAZORPAY_WEBHOOK_SECRET=CHANGE_THIS_WEBHOOK_SECRET

# ── Caching ───────────────────────────────────────────────────
CART_CACHE_TTL=604800
CART_CACHE_ENABLED=true
PRODUCT_CACHE_TTL=300
PRODUCT_CACHE_ENABLED=true

# ── Optional monitoring ───────────────────────────────────────
SENTRY_DSN=
