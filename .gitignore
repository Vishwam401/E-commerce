# Ignore environment files containing sensitive data
.env
.env*
!.env.example
!production.env.template

# Ignore virtual environments
.venv
venv

# Ignore Python cache and bytecode
__pycache__/
*.pyc

# Ignore IDE local files
.idea/

# Ignore test and cache folders
tests/
.pytest_cache/
.hypothesis/

# Ignore logs
*.log

# Frontend — ignore build artifacts and deps, but track source code
frontend/node_modules/
frontend/dist/
frontend/.vite/
